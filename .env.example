APP_ENV=local
GRPC_HOST=0.0.0.0
GRPC_PORT=50052
NETWORK=tcp
SHUTDOWN_TIMEOUT=10s

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=bank
DB_SSL_MODE=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=30m
DB_CONN_MAX_IDLE_TIME=5m

REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_POOL_SIZE=10
REDIS_MIN_IDLE=2

# Prepared for future integration; no producer or consumer is created yet.
KAFKA_ENABLED=false
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=bank-repository-service
KAFKA_CONSUMER_GROUP=bank-repository-service
