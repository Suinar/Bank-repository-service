# Application environment reported in service logs.
APP_ENV=local

# gRPC server bind address and container port.
GRPC_HOST=0.0.0.0
GRPC_PORT=50052

# Host port published by Docker Compose; it does not change the container port.
GRPC_HOST_PORT=50052

# Network accepted by net.Listen (normally tcp).
NETWORK=tcp

# Maximum time allowed for graceful gRPC shutdown.
SHUTDOWN_TIMEOUT=10s

# PostgreSQL connection used when the service runs directly on the host.
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=bank
DB_SSL_MODE=disable

# Host port published by the Compose PostgreSQL container.
DB_HOST_PORT=5432

# PostgreSQL connection-pool limits and connection recycling intervals.
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=30m
DB_CONN_MAX_IDLE_TIME=5m

# Redis connection and pool configuration.
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_POOL_SIZE=10
REDIS_MIN_IDLE=2

# Host port published by the Compose Redis container.
REDIS_HOST_PORT=6379

# Enable this to create repository topics in the configured Kafka cluster.
KAFKA_ENABLED=true
KAFKA_BROKERS=localhost:9092

# Host port published by the Compose Kafka broker.
KAFKA_HOST_PORT=9092

# Comma-separated topics owned by this service; creation is idempotent.
KAFKA_TOPICS=bank.user.events,bank.account.events,bank.card.events,bank.credit.events,bank.deposit.events,bank.currency.events

# Reserved identities for future Kafka producers and consumers.
KAFKA_CLIENT_ID=bank-repository-service
KAFKA_CONSUMER_GROUP=bank-repository-service
